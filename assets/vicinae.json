{
  "$schema": "https://vicinae.com/schemas/config.json",
  "close_on_focus_loss": true,
  "pop_to_root_on_close": true,
  "theme": {
    "light": {
      "name": "ayu-dark"
    }
  },
  "providers": {
    "@knoopx/vicinae-extension-nix-0": {
      "entrypoints": {
        "home-manager-options": {
          "alias": "h"
        },
        "options": {
          "alias": "o"
        },
        "packages": {
          "alias": "p"
        }
      }
    },
    "@mattisssa/spotify-player-vicinae-extension": {
      "entrypoints": {
        "findLyrics": {
          "enabled": false
        },
        "generatePlaylist": {
          "enabled": false
        }
      }
    },
    "@mblode/google-vicinae-extension": {
      "entrypoints": {
        "index": {
          "alias": "g"
        }
      }
    },
    "@tonka3000/home-assistant-vicinae-extension": {
      "preferences": {
        "camerarefreshinterval": "3000",
        "ignorecerts": false,
        "instance": "https://ha.profidev.io",
        "showEntityId": false,
        "usePing": true
      }
    },
    "calculator": {
      "preferences": {
        "backend": "soulver-core",
        "refreshRatesOnStartup": true
      }
    }
  }
}
